# Copie este arquivo para .env e preencha. O .env não vai para o Git.
SENHA_ROOT_MYSQL=troque_esta_senha
SENHA_BANCO=troque_esta_senha_tambem
# Senha do usuário admin@gestao.com, criado na primeira execução
SENHA_ADMIN=troque_a_senha_do_administrador
# Pelo menos 32 caracteres
CHAVE_JWT=troque_por_uma_chave_secreta_com_pelo_menos_32_caracteres
# Endereço do fluxo que envia o e-mail de boas-vindas (entre aspas simples).
# Se ficar vazio, a senha temporária aparece na tela para o administrador.
URL_POWER_AUTOMATE=''
